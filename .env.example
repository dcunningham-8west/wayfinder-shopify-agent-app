# Keys only. Values live in .env locally and in the Render dashboard in production.

# Retell signs tool webhooks with the API key itself — there is no separate webhook secret.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Pinned, not discovered: the prompt sync pushes to this id and never reads the dashboard.
RETELL_LLM_ID=
BACKEND_PUBLIC_URL=https://wayfinder-voice-bot-backend.onrender.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
PORT=3000
